{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/courses/:path*", "destination": "/api/index" },
    { "source": "/homework/:path*", "destination": "/api/index" },
    { "source": "/english/:path*", "destination": "/api/index" },
    { "source": "/reading/:path*", "destination": "/api/index" },
    { "source": "/reading-speed/:path*", "destination": "/api/index" },
    { "source": "/conformity/:path*", "destination": "/api/index" },
    { "source": "/texts/:path*", "destination": "/api/index" },
    { "source": "/reading-by-algorithm/:path*", "destination": "/api/index" },
    { "source": "/motivational-trainer.html", "destination": "/api/index" },
    { "source": "/memory.html", "destination": "/api/index" },
    { "source": "/emotional-intelligence.html", "destination": "/api/index" },
    { "source": "/send_test.php", "destination": "/api/telegram/test" },
    { "source": "/send_homework.php", "destination": "/api/telegram/homework" },
    { "source": "/send_reading.php", "destination": "/api/telegram/reading" },
    { "source": "/send_emotional.php", "destination": "/api/telegram/emotional" },
    { "source": "/send_trainer.php", "destination": "/api/telegram/trainer" },
    { "source": "/send_conformity.php", "destination": "/api/telegram/conformity" },
    { "source": "/send_memory.php", "destination": "/api/telegram/memory" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "server/src/**"
    }
  },
  "buildCommand": "npm run vercel-build"
}